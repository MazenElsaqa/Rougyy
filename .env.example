# --- Database ---
DATABASE_URL=sqlite:///./data/concert_singer.sqlite

# --- LLM: OpenAI-compatible SDK (local Ollama default) ---
# Install Ollama, then run: ollama pull qwen2.5-coder:7b
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5-coder:7b

# Optional cloud alternatives:
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=
# LLM_MODEL=gpt-4o
#
# OPENAI_API_KEY=AIza...
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-1.5-pro

# --- Query execution ---
QUERY_TIMEOUT_MS=5000

# --- Tracing (Phase 1) ---
OTEL_SERVICE_NAME=ai-database-agent
OTEL_TRACES_EXPORTER=console

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

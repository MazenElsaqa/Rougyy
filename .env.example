# --- Database ---
DATABASE_URL=sqlite:///./data/concert_singer.sqlite

# --- LLM provider ---
# For local Ollama on macOS, set these values and leave API keys empty.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Chat model used only for answer phrasing (falls back to OLLAMA_MODEL when unset).
OLLAMA_ANSWER_MODEL=qwen3.5:4b-mlx

# For hosted OpenAI-compatible providers instead:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=
# LLM_MODEL=gpt-4o

# Ollama also supports the OpenAI-compatible endpoint automatically.
OPENAI_API_KEY=ollama
LLM_MODEL=qwen2.5-coder:7b

# Use Gemini via its OpenAI-compatible endpoint instead:
# OPENAI_API_KEY=AIza...
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-1.5-pro
# Use local Ollama instead:
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3

# --- Query execution ---
QUERY_TIMEOUT_MS=5000

# --- Tracing (Phase 1) ---
OTEL_SERVICE_NAME=ai-database-agent
OTEL_TRACES_EXPORTER=console

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=sqlite:///./data/concert_singer.sqlite

# --- Gemini (added in Phase 5, kept here so .env shape is stable from the start) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# --- Query execution ---
QUERY_TIMEOUT_MS=5000

# --- Tracing (Phase 1) ---
OTEL_SERVICE_NAME=ai-database-agent
OTEL_TRACES_EXPORTER=console
# Set to a real collector endpoint later if desired, e.g.:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
